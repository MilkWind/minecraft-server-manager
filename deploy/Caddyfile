# Minecraft Server Manager reverse proxy.
#
# Override these values in the deployment environment when needed:
# - APP_SITE_ADDRESS: public host, for example minecraft.example.com
# - FRONTEND_UPSTREAM: frontend service address, for example frontend:4173
# - BACKEND_UPSTREAM: backend service address, for example backend:8080

{$APP_SITE_ADDRESS:localhost} {
	encode zstd gzip

	@api path /api/*
	reverse_proxy @api {$BACKEND_UPSTREAM:localhost:8080}

	reverse_proxy {$FRONTEND_UPSTREAM:localhost:4173}
}
